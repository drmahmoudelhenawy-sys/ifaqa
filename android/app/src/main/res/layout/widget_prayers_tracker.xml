<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/glass_gradient"
    android:orientation="vertical"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تتبع الصلوات"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView android:id="@+id/icon_fajr" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_prayer_off" android:layout_margin="4dp"/>
        <ImageView android:id="@+id/icon_dhuhr" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_prayer_off" android:layout_margin="4dp"/>
        <ImageView android:id="@+id/icon_asr" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_prayer_off" android:layout_margin="4dp"/>
        <ImageView android:id="@+id/icon_maghrib" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_prayer_off" android:layout_margin="4dp"/>
        <ImageView android:id="@+id/icon_isha" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_prayer_off" android:layout_margin="4dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tracker_xp_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+50 XP"
        android:textColor="#A78BFA"
        android:textSize="10sp"
        android:layout_marginTop="8dp"/>

</LinearLayout>
